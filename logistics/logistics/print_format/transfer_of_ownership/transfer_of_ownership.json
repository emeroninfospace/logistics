 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: Arial, sans-serif;\n            font-size: 14px;\n            color: #000;\n            line-height: 1.6;\n        }\n\n        .container {\n            padding: 20px 30px;\n            width: 100%;\n        }\n\n        /* ---------------- Header ---------------- */\n        .header {\n            margin-bottom: 20px;\n        }\n\n        .header img {\n            height: 70px;\n            margin-bottom: 10px;\n        }\n\n        .date {\n            font-size: 14px;\n            color: #333;\n        }\n\n        /* ---------------- Title ---------------- */\n        .title {\n            text-align: center;\n            margin: 25px 0;\n        }\n\n        .title h2 {\n            font-size: 24px;\n            font-weight: bold;\n            text-decoration: underline;\n        }\n\n        /* ---------------- Content ---------------- */\n        .content-text {\n            margin: 20px 0;\n            line-height: 1.8;\n        }\n\n        .content-text p {\n            margin: 8px 0;\n        }\n\n        /* ---------------- Details Table ---------------- */\n        .details-table {\n            width: 100%;\n            margin: 25px 0;\n            border-collapse: collapse;\n            page-break-inside: avoid;\n        }\n\n        .details-table td {\n            padding: 8px 0;\n            vertical-align: top;\n        }\n\n        .details-table td:first-child {\n            width: 35%;\n        }\n\n        .details-table td:last-child {\n            width: 65%;\n            padding-left: 15px;\n        }\n\n        /* ---------------- Signature Section ---------------- */\n        .signature-section {\n            margin-top: 35px;\n            page-break-inside: avoid;\n        }\n\n        .signature-block {\n            margin: 25px 0;\n            page-break-inside: avoid;\n        }\n\n        .signature-label {\n            font-weight: bold;\n            margin-bottom: 10px;\n        }\n\n        .signature-line {\n            width: 300px;\n            height: 60px;\n            border-bottom: 1px solid #000;\n        }\n\n        .stamp-area {\n            height: 80px;\n        }\n\n        .certification-text {\n            margin: 25px 0;\n            line-height: 1.8;\n        }\n\n        /* ---------------- Print Settings ---------------- */\n        @media print {\n            @page {\n                size: A4;\n                margin: 10mm;\n            }\n        }\n    </style>\n</head>\n\n<body>\n<div class=\"container\">\n\n    <!-- Header -->\n    <div class=\"header\">\n        {% if doc.company %}\n            {% set company_logo = frappe.db.get_value('Company', doc.company, 'company_logo') %}\n            {% if company_logo %}\n                <img src=\"{{ company_logo }}\">\n            {% endif %}\n        {% endif %}\n        <div class=\"date\">\n            {{ doc.posting_date }}\n        </div>\n    </div>\n\n    <!-- Title -->\n    <div class=\"title\">\n        <h2>Transfer of Ownership</h2>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"content-text\">\n        <p>\n            Please note that we have this day transferred the ownership of the under mentioned goods to\n            {{ doc.customer_name or doc.supplier_name or doc.party_name or \"Aliz Logistics FZE\" }}.\n        </p>\n    </div>\n\n    <!-- Details -->\n    <table class=\"details-table\">\n        <tbody>\n            {% set invoice = frappe.db.get_value(\"Invoice Item\", {\"outbound\": doc.name}, \"parent\") %}\n\n            <tr>\n                <td>Our Invoice No :</td>\n                {% if company_logo %}\n                <td>{{ invoice }}</td>\n                {% endif %}\n            </tr>\n            <tr>\n                <td>Jafz-BoE No / Jafz Tran :</td>\n                <td>{{ doc.lr_no or doc.custom_jafz_boe_no or \"B/E Numbers as per document\" }}</td>\n            </tr>\n            <tr>\n                <td>Country of Origin :</td>\n                <td>\n                    {% if doc.items and doc.items[0].get('coo') %}\n                        {{ doc.items[0].coo }}\n                    {% else %}\n                        Country of Origin as per document\n                    {% endif %}\n                </td>\n            </tr>\n            <tr>\n                <td>Description of Goods :</td>\n                <td>\n                    {% if doc.items %}\n                        {% set item_names = [] %}\n                        {% for item in doc.items[:3] %}\n                            {% set _ = item_names.append(item.item_name or item.item_code) %}\n                        {% endfor %}\n                        {{ item_names | join(', ') }}\n                        {% if doc.items | length > 3 %}\n                            and {{ doc.items | length - 3 }} more\n                        {% endif %}\n                    {% else %}\n                        Computer Products\n                    {% endif %}\n                </td>\n            </tr>\n            <tr>\n                <td>PCS :</td>\n                <td>\n                    {{ doc.total_qty  }}\n                </td>\n            </tr>\n            <tr>\n                <td>Weight :</td>\n                <td> {{ doc.total_gross_wt }} KG</td>\n            </tr\n        </tbody>\n    </table>\n\n    <!-- Signatures -->\n    <div class=\"signature-section\">\n\n        <div class=\"signature-block\">\n            <div class=\"signature-label\">Owner Stamp and Signature</div>\n            <div class=\"signature-line\"></div>\n        </div>\n\n        <div class=\"certification-text\">\n            We hereby certify that as from this date, we are the owners of the above mentioned goods and\n            I/we undertake to pay when called upon to do so, all port charges and accruing thereon.\n        </div>\n\n        <div class=\"signature-block\">\n            <div class=\"signature-label\">Transferees Stamp and Signature</div>\n            <div class=\"stamp-area\"></div>\n        </div>\n\n    </div>\n\n</div>\n</body>\n</html>\n",
